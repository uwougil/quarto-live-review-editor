{
  "name": "markdown-live-preview-editor",
  "displayName": "Quarto Live Review Editor",
  "description": "Markdown/Quarto 单栏实时预览编辑器，支持数学公式、代码单元、表格、Mermaid、draw.io 和自定义 CSS 主题。",
  "version": "0.0.12",
  "publisher": "t-shoot",
  "license": "MIT",
  "icon": "media/icon-128.png",
  "keywords": [
    "markdown",
    "markdown editor",
    "markdown preview",
    "live preview",
    "wysiwyg",
    "obsidian",
    "note taking",
    "notes",
    "mermaid",
    "preview",
    "css theme",
    "editor",
    "drawio",
    "draw.io",
    "diagrams.net",
    "diagram",
    "architecture diagram"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uwougil/quarto-live-review-editor.git"
  },
  "bugs": {
    "url": "https://github.com/uwougil/quarto-live-review-editor/issues"
  },
  "homepage": "https://github.com/uwougil/quarto-live-review-editor#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdLivePreview.editor",
        "displayName": "Quarto Live Review",
        "selector": [
            {
              "filenamePattern": "*.md"
            },
            {
              "filenamePattern": "*.qmd"
            },
          {
            "filenamePattern": "**/temp/readonly/*"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdLivePreview",
          "title": "Quarto Live Review Editor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mdLivePreview": [
        {
          "id": "mdLivePreview.outline",
          "name": "大纲",
          "type": "webview"
        },
        {
          "id": "mdLivePreview.styleManager",
          "name": " ",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mdLivePreview.openWithLivePreview",
        "title": "使用实时预览打开",
        "category": "Quarto Live Review",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdLivePreview.openWithSource",
        "title": "打开源码",
        "category": "Quarto Live Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdLivePreview.newStyle",
        "title": "新建 CSS 样式",
        "category": "Quarto Live Review",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdLivePreview.openWithLivePreview",
          "when": "(resourceLangId == markdown || resourceExtname == .qmd) && activeCustomEditorId != mdLivePreview.editor",
          "group": "navigation"
        },
        {
          "command": "mdLivePreview.openWithSource",
          "when": "activeCustomEditorId == mdLivePreview.editor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mdLivePreview.newStyle",
          "when": "view == mdLivePreview.styleManager",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Quarto Live Review",
      "properties": {
        "mdLivePreview.codeTheme": {
          "type": "string",
          "enum": [
            "auto",
            "dark-plus",
            "light-plus",
            "github-dark",
            "github-light"
          ],
          "enumDescriptions": [
            "跟随 VS Code 颜色主题（浅色/深色），使用 VS Code 标准 Dark+/Light+ 配色。",
            "VS Code 标准深色主题（Dark+）配色。",
            "VS Code 标准浅色主题（Light+）配色。",
            "GitHub 深色配色。",
            "GitHub 浅色配色。"
          ],
          "default": "auto",
          "description": "代码块语法高亮主题。\"auto\" 会跟随 VS Code 颜色主题。"
        },
        "mdLivePreview.enabledStyles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "应用于实时预览的 CSS 主题，可从侧边栏 CSS 主题视图中选择一个。"
        },
        "mdLivePreview.defaultEditor": {
          "type": "string",
          "enum": [
            "prompt",
            "livePreview",
            "default"
          ],
          "enumDescriptions": [
            "默认使用普通文本编辑器，通过工具栏按钮手动打开实时预览。",
            "始终使用 Quarto Live Review 打开 .md/.qmd 文件。",
            "始终使用 VS Code 普通文本编辑器打开 .md/.qmd 文件。"
          ],
          "default": "prompt",
          "description": "控制 .md/.qmd 文件是否默认使用 Quarto Live Review。"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:long-fixtures": "node scripts/generate-long-fixtures.mjs",
    "generate:long-fixtures": "node scripts/generate-long-fixtures.mjs",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit -p tsconfig.json --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.3.2",
    "@shikijs/core": "^1.24.0",
    "@shikijs/engine-javascript": "^1.24.0",
    "@shikijs/langs": "^1.24.0",
    "@shikijs/themes": "^1.24.0",
    "katex": "^0.16.47",
    "mermaid": "^11.4.1",
    "yaml": "^2.9.0"
  }
}
